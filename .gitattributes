# Signed files must reach GitHub byte for byte, or their signatures stop matching
listings/** -text
*.sig -text

# Windows scripts keep Windows line endings
*.bat text eol=crlf
*.ps1 text eol=crlf

# Shell scripts run on Linux servers
*.sh text eol=lf

# The installer kept in releases/ is binary: never touch its bytes
*.exe binary
releases/SHA256SUMS.txt text eol=lf
